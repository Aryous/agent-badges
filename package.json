{
  "name": "agent-badges",
  "version": "0.5.0",
  "description": "Turn your local Claude Code and Codex history into Apple Watch–style 3D achievement badges. Offline, private, no upload.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-badges": "bin/agent-badges.mjs"
  },
  "files": [
    "bin/",
    "dist/index.html",
    "src/cli/",
    "src/collect/",
    "src/data/hash.js",
    "src/data/normalize.js",
    "src/data/metrics-common.js",
    "src/data/claude-code-metrics.js",
    "src/data/codex-metrics.js",
    "src/data/daily.js",
    "src/data/calendar.js",
    "src/data/highlights.js",
    "src/data/tiers.js",
    "src/brands/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "claude-code",
    "codex",
    "achievements",
    "badges",
    "three.js",
    "developer-tools",
    "ai-coding"
  ],
  "homepage": "https://aryous.github.io/agent-badges/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aryous/agent-badges.git"
  },
  "bugs": {
    "url": "https://github.com/Aryous/agent-badges/issues"
  },
  "author": "Aryous",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "collect": "node bin/agent-badges.mjs collect",
    "check:browser": "node scripts/shoot.mjs",
    "start": "node bin/agent-badges.mjs",
    "prepack": "npm run build && npm test",
    "build:site": "vite build && vite build -c vite.site.config.js && node scripts/build-site.mjs",
    "preview:site": "python3 -m http.server 4848 -d dist-site",
    "check:site": "node scripts/check-site.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:shelf": "node scripts/check-shelf.mjs"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "opentype.js": "2.0.0",
    "playwright-core": "1.64.1",
    "three": "0.186.1",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
